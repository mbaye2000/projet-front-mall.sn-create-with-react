# Exemple de configuration pour l'application React
# Copiez ce fichier en .env.local pour le développement local.
# Ne commitez pas .env.local, il est déjà ignoré par git.

# URL du backend local
REACT_APP_API_URL=http://localhost:5020/api

# En production (Vercel), vous pouvez définir cette valeur sur votre backend Render :
# REACT_APP_API_URL=https://projet-back-end-mall-sn-with-react.onrender.com/api
